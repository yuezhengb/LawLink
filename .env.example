# LawLink 环境变量模板
# 复制为 .env 后填入真实值。.env 不会进 git，绝不提交。

# —— 数据库 ——
# 本地开发（直连 Postgres）：
DATABASE_URL="postgresql://lawlink:lawlink@localhost:5432/lawlink?schema=public"

# Postgres 容器变量（仅 docker compose 用）
POSTGRES_DB=lawlink
POSTGRES_USER=lawlink
POSTGRES_PASSWORD=lawlink
POSTGRES_PORT=5432

# —— 鉴权 ——
# 生成方法：openssl rand -base64 32
NEXTAUTH_SECRET="REPLACE_WITH_OUTPUT_OF_openssl_rand_base64_32"
NEXTAUTH_URL="http://localhost:3000"

# —— 文件存储与加密 ——
APP_STORAGE_DIR="./storage"
# 文件加密主密钥（AES-256-GCM），base64 编码的 32 字节
# 生成方法：openssl rand -base64 32
# ⚠️ 丢失此密钥则所有加密材料不可恢复，独立于数据库备份
STORAGE_ENCRYPTION_KEY="REPLACE_WITH_OUTPUT_OF_openssl_rand_base64_32"

# —— 内部财务旧 XLS / PDF 隔离预处理服务（启用 finance-preprocessor profile 时必填）——
# 生成随机长令牌；同一令牌注入 app 与 finance-preprocessor 容器，不提交真实值。
FINANCE_PREPROCESSOR_URL="http://finance-preprocessor:8080"
FINANCE_PREPROCESSOR_TOKEN=""

# —— 云存储（可选，v0.17）——
# 切到 s3 时所有后续 writeFile 都写 S3；已写的 local 文件不会自动迁移
# STORAGE_PROVIDER="local"     # 默认 local；改为 "s3" 启用云存储
# AWS_REGION="ap-northeast-1"
# S3_BUCKET="lawlink-storage"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# S3_ENDPOINT=""               # 可选，自建 S3 兼容（MinIO / R2 / 阿里云 OSS 兼容端点）
# S3_FORCE_PATH_STYLE="false"  # MinIO 必须 true
# S3_KEY_PREFIX="prod/"        # 可选，所有对象 key 前缀

# —— 初始管理员（仅 seed 时使用）——
SEED_ADMIN_EMAIL="admin@lawlink.local"
SEED_ADMIN_PASSWORD="ChangeMe!2026"
SEED_ADMIN_NAME="系统管理员"

# v0.50 自动备份（每天 02:30，调 scripts/backup.sh）
# BACKUP_CRON_ENABLED=false   # 部署环境没有 pg_dump 时关闭
# BACKUP_DIR=./backups        # 备份输出目录
# BACKUP_KEEP=14              # 保留最近 N 份

# —— 运维开关 ——
# AuditLog 保留检查阈值（天）：每天 03:00 统计超期可归档数量（仅统计，从不物理删除）
# AUDIT_RETENTION_DAYS=365
# 提醒送达台账明细保留天数（每天 03:10 清理超期行；仅台账，不涉及 AuditLog）
# REMINDER_LEDGER_RETENTION_DAYS=180
# 禁用进程内定时作业（=1 时）：提醒扫描、备份、队列 worker 全部不注册，
# 仅供调试或使用外部调度器时使用；本地开发（npm run dev）本就不跑定时作业
# DISABLE_CRON=1

# ---- 邮件提醒（SMTP，v1.x 个人提醒渠道） ----
# 留空则邮件渠道自动停用（站内通知与群机器人不受影响）。
# 本地联调：docker compose --profile dev up mailpit，然后
#   SMTP_HOST=localhost SMTP_PORT=1025 MAIL_FROM=lawlink@localhost
# 收件箱界面 http://localhost:8025
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
